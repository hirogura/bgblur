[Unit]
Description=bgblur v.0.1.0 (商品写真の背景を自動でぼかす自ホスト サービス)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bgblur
ExecStart=/opt/bgblur/.venv/bin/python -m bgblur
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=BGBLUR_HOST=127.0.0.1
Environment=BGBLUR_PORT=3371
# 背景セグメンテーションに使う rembg のモデル (u2net / u2netp / isnet-general-use など).
# Environment=BGBLUR_MODEL=u2net
# 破壊的な操作 (再起動 / アップデート) を制限する場合は
# Environment=BGBLUR_ADMIN_TOKEN=... を追加する.

[Install]
WantedBy=multi-user.target
